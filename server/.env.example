# Server Port & Client URL
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local SQLite or Turso Cloud SQLite)
# For local development:
DB_PATH=./database.db
# For Turso Cloud deployment (uncomment on Zeabur):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Secrets
JWT_ACCESS_SECRET=vibegram_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=vibegram_refresh_secret_key_change_me_in_production

# Cloudflare R2 Media Storage (10GB Free, 0 Egress)
# Leave blank to use local /uploads folder
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=vibegram-media
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# File Limits
MAX_FILE_SIZE_MB=10
