# Server Port & Client URL
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local SQLite or Turso Cloud SQLite)
DB_PATH=./database.db
# For Turso Cloud deployment (uncomment on Zeabur):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT Secrets
JWT_ACCESS_SECRET=vibegram_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=vibegram_refresh_secret_key_change_me_in_production

# Cloudinary Media Storage (100% Free, NO CREDIT CARD NEEDED)
# Sign up at https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional: Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# File Limits
MAX_FILE_SIZE_MB=10
